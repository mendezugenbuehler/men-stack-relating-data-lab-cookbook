<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Food Item</title>
  </head>
  <body>
    <%- include('../partials/_navbar.ejs') %>
    <h1>Edit Food Item</h1>

    <form action="/users/<%= user._id %>/foods/<%= food._id %>?_method=PUT" method="POST">
      <label for="name">Name:</label>
      <input type="text" id="name" name="name" value="<%= food.name %>" required><br>
      
      <label for="quantity">Quantity:</label>
      <input type="number" id="quantity" name="quantity" value="<%= food.quantity %>" min="0"><br>
      
      <label for="category">Category:</label>
      <select id="category" name="category">
        <option value="vegetable" <%= food.category === 'vegetable' ? 'selected' : '' %>>Vegetable</option>
        <option value="fruit" <%= food.category === 'fruit' ? 'selected' : '' %>>Fruit</option>
        <option value="dairy" <%= food.category === 'dairy' ? 'selected' : '' %>>Dairy</option>
        <option value="meat" <%= food.category === 'meat' ? 'selected' : '' %>>Meat</option>
        <option value="grain" <%= food.category === 'grain' ? 'selected' : '' %>>Grain</option>
        <option value="beverage" <%= food.category === 'beverage' ? 'selected' : '' %>>Beverage</option>
        <option value="snack" <%= food.category === 'snack' ? 'selected' : '' %>>Snack</option>
      </select><br>
      
      <label for="organic">Organic:</label>
      <input type="checkbox" id="organic" name="organic" <%= food.organic ? 'checked' : '' %>><br>
      
      <button type="submit">Update Food Item</button>
    </form>
  </body>
</html>
