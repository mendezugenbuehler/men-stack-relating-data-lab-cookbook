<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= user.username %>'s Pantry
    </title>
</head>

<body>
    <header>
        <%- include('../partials/_navbar.ejs') %>
    </header>

    <main>
        <h1>
            <%= user.username %>'s Pantry
        </h1>

        <% if (user.pantry.length> 0) { %>
            <ul>
                <% user.pantry.forEach((food)=> { %>
                    <li>
                        <strong>
                            <%= food.name %>
                        </strong><br />
                        Quantity: <%= food.quantity %><br />
                            Category: <%= food.category %><br />
                                Organic: <%= food.organic ? 'Yes' : 'No' %>
                    </li>
                    <% }); %>
            </ul>
            <% } else { %>
                <p>This user has no items in their pantry.</p>
                <% } %>
    </main>
</body>

</html>